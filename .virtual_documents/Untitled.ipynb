import requests

# Define the base URL and endpoint
url = "https://api.open.fec.gov/v1/candidates/search/"

# Set up the query parameters
params = {
    "q": "alsobrooks",
    "api_key": "DEMO_KEY"
}

# Make the GET request
response = requests.get(url, params=params)
data = response.json()

# Loop through the results to extract the candidate names and IDs
if "results" in data:
    for candidate in data["results"]:
        print(f"Name: {candidate.get('name')} | ID: {candidate.get('candidate_id')}")



